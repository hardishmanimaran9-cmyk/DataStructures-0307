void quick(Record a[], int lo, int hi, int depth) {
if(depth&gt;max_depth)max_depth=depth;
if(lo&gt;=hi)return;
int p=partition(a, lo, hi);
quick(a, lo, p-1, depth+1);
quick(a, p+1, hi, depth+1);
}
void merge(Record a[], Record t[], int lo, int mid, int hi) {
int i=lo, j=mid+1, k=lo;
while(i&lt;=mid&amp;&amp;j&lt;=hi) {
comparisons++;
if(a[i].mark&lt;=a[j].mark)t[k++]=a[i++];
else t[k++]=a[j++];
}
while(i&lt;=mid)t[k++]=a[i++];
while(j&lt;=hi)t[k++]=a[j++];
for(i=lo;i&lt;=hi;i++)a[i]=t[i];
}
void msort(Record a[], Record t[], int lo, int hi) {
if(lo&gt;=hi)return;
int mid=lo+(hi-lo)/2;
msort(a, t, lo, mid);
msort(a, t, mid+1, hi);
merge(a, t, lo, mid, hi);
}
