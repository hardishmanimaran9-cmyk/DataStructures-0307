int partition(Record a[], int lo, int hi) {
int pivot=a[hi].mark, i=lo-1;
for(int j=lo;j&lt;hi;j++) {
comparisons++;
if(a[j].mark&lt;=pivot) {
i++;
sw(&amp;a[i], &amp;a[j]);
