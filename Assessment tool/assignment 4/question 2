#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define BUCKETS 7
typedef struct Member {
    char id[12];
    char name[20];
    struct Member *next;
}
Member;
Member *table[BUCKETS] = {
    NULL
}
;
unsigned hash_id(const char *s) {
    unsigned h=0;
    while (*s) h=h*31u+(unsigned char)*s++;
    return h%BUCKETS;
}
void put(const char *id, const char *name) {
    unsigned b=hash_id(id);
    Member *m=malloc(sizeof *m);
    if(!m) {
        perror("malloc");
        exit(EXIT_FAILURE);
    }
    snprintf(m->id, sizeof m->id, "%s", id);
    snprintf(m->name, sizeof m->name, "%s", name);
    m->next=table[b];
    table[b]=m;
}
const char *get(const char *id, int *probes) {
    *probes=0;
    for(Member *m=table[hash_id(id)];m;m=m->next) {
        ++*probes;
        if(strcmp(m->id, id)==0)return m->name;
    }
    return NULL;
}
int remove_member(const char *id) {
    Member **link=&table[hash_id(id)];
    while(*link) {
        Member *cur=*link;
        if(strcmp(cur->id, id)==0) {
            *link=cur->next;
            free(cur);
            return 1;
        }
        link=&cur->next;
    }
    return 0;
}
void destroy(void) {
    for(int b=0;b<BUCKETS;b++)
    while(table[b]) {
        Member *next=table[b]->next;
        free(table[b]);
        table[b]=next;
    }
}
int main(void) {
    const char *ids[]= {
        "CSE1043", "ECE2210", "MEC3307",
        "CSE1044", "BME4120", "CIV5009"
    }
    ;
    const char *names[]= {
        "Kavya", "Arjun", "Fathima",
        "Rahul", "Deepa", "Manoj"
    }
    ;
    for(int i=0;i<6;i++)put(ids[i], names[i]);
    for(int b=0;b<BUCKETS;b++) {
        int len=0;
        for(Member *m=table[b];m;m=m->next)len++;
        printf("%d", len);
    }
    int probes;
    const char *who=get("CSE1044", &probes);
    printf("\nCSE1044 -> %s (%d probes)\n",
    who?who:"not found", probes);
    who=get("CSE9999", &probes);
    printf("CSE9999 -> %s (%d probes)\n",
    who?who:"not found", probes);
    remove_member("CSE1044");
    destroy();
    return 0;
}
