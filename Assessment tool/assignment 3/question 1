#include <stdio.h>
#include <stdlib.h>
typedef struct N {
    int k;
    struct N *l, *r;
}
N;
N *make(int k) {
    N*n=malloc(sizeof *n);
    if(!n)exit(1);
    n->k=k;
    n->l=n->r=NULL;
    return n;
}
N *ins(N*t, int k) {
    if(!t)return make(k);
    if(k<t->k)t->l=ins(t->l, k);
    else if(k>t->k)t->r=ins(t->r, k);
    return t;
}
N *find(N*t, int k, int*c) {
    *c=0;
    while(t) {
        ++*c;
        if(k==t->k)return t;
        t=k<t->k?t->l:t->r;
    }
    return NULL;
}
int ht(N*t) {
    if(!t)return -1;
    int a=ht(t->l), b=ht(t->r);
    return 1+(a>b?a:b);
}
void pre(N*t) {
    if(t) {
        printf("%d ", t->k);
        pre(t->l);
        pre(t->r);
    }
}
void in(N*t) {
    if(t) {
        in(t->l);
        printf("%d ", t->k);
        in(t->r);
    }
}
void post(N*t) {
    if(t) {
        post(t->l);
        post(t->r);
        printf("%d ", t->k);
    }
}
void level(N*t) {
    if(!t)return;
    N*q[10000];
    int a=0, b=0;
    q[b++]=t;
    while(a<b) {
        N*x=q[a++];
        printf("%d ", x->k);
        if(x->l)q[b++]=x->l;
        if(x->r)q[b++]=x->r;
    }
}
N*minn(N*t) {
    while(t&&t->l)t=t->l;
    return t;
}
N*del(N*t, int k) {
    if(!t)return NULL;
    if(k<t->k)t->l=del(t->l, k);
    else if(k>t->k)t->r=del(t->r, k);
    else {
        if(!t->l) {
            N*x=t->r;
            free(t);
            return x;
        }
        if(!t->r) {
            N*x=t->l;
            free(t);
            return x;
        }
        N*s=minn(t->r);
        t->k=s->k;
        t->r=del(t->r, s->k);
    }
    return t;
}
void freeall(N*t) {
    if(t) {
        freeall(t->l);
        freeall(t->r);
        free(t);
    }
}
int main(void) {
    int a[]= {
        500, 300, 700, 200, 400, 600, 800, 350
    }
    , s[]= {
        10, 20, 30, 40, 50, 60, 70, 80
    }
    ;
    N*r=NULL, *z=NULL;
    for(int i=0;i<8;i++) {
        r=ins(r, a[i]);
        z=ins(z, s[i]);
    }
    printf("Inorder: ");
    in(r);
    printf("\nPreorder: ");
    pre(r);
    printf("\nPostorder: ");
    post(r);
    printf("\nLevel order: ");
    level(r);
    printf("\nHeights random=%d sorted=%d\n", ht(r), ht(z));
    int c;
    printf("350 found=%s comparisons=%d\n", find(r, 350, &c)?"yes":"no", c);
    r=del(r, 200);
    r=del(r, 300);
    r=del(r, 500);
    printf("After deletes: ");
    pre(r);
    freeall(r);
    freeall(z);
    return 0;
}
