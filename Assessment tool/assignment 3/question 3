#include <stdio.h>
#include <stdlib.h>
#define T 2
typedef struct B {
    int n, leaf, k[2*T-1];
    struct B*c[2*T];
}
B;
B*newb(int leaf) {
    B*x=calloc(1, sizeof* x);
    if(!x)exit(1);
    x->leaf=leaf;
    return x;
}
B*search(B*x, int k) {
    if(!x)return NULL;
    int i=0;
    while(i<x->n&&k>x->k[i])i++;
    if(i<x->n&&k==x->k[i])return x;
    return x->leaf?NULL:search(x->c[i], k);
}
void split(B*p, int i) {
    B*y=p->c[i], *z=newb(y->leaf);
    z->n=T-1;
    for(int j=0;j<T-1;j++)z->k[j]=y->k[j+T];
    if(!y->leaf)for(int j=0;j<T;j++)z->c[j]=y->c[j+T];
    y->n=T-1;
    for(int j=p->n;j>=i+1;j--)p->c[j+1]=p->c[j];
    p->c[i+1]=z;
    for(int j=p->n-1;j>=i;j--)p->k[j+1]=p->k[j];
    p->k[i]=y->k[T-1];
    p->n++;
}
void nonfull(B*x, int k) {
    int i=x->n-1;
    if(x->leaf) {
        while(i>=0&&k<x->k[i]) {
            x->k[i+1]=x->k[i];
            i--;
        }
        x->k[i+1]=k;
        x->n++;
    }
    else {
        while(i>=0&&k<x->k[i])i--;
        i++;
        if(x->c[i]->n==2*T-1) {
            split(x, i);
            if(k>x->k[i])i++;
        }
        nonfull(x->c[i], k);
    }
}
B*insert(B*r, int k) {
    if(!r) {
        r=newb(1);
        r->k[0]=k;
        r->n=1;
        return r;
    }
    if(search(r, k))return r;
    if(r->n==2*T-1) {
        B*s=newb(0);
        s->c[0]=r;
        split(s, 0);
        int i=k>s->k[0];
        nonfull(s->c[i], k);
        return s;
    }
    nonfull(r, k);
    return r;
}
void show(B*x, int d) {
    if(!x)return;
    printf("level %d [", d);
    for(int i=0;i<x->n;i++)printf("%s%d", i?" ":"", x->k[i]);
    puts("]");
    if(!x->leaf)for(int i=0;i<=x->n;i++)show(x->c[i], d+1);
}
void freeb(B*x) {
    if(x) {
        if(!x->leaf)for(int i=0;i<=x->n;i++)freeb(x->c[i]);
        free(x);
    }
}
int main(void) {
    int a[]= {
        10, 20, 5, 6, 12, 30, 7, 17
    }
    ;
    B*r=NULL;
    for(int i=0;i<8;i++) {
        r=insert(r, a[i]);
        printf("After %d\n", a[i]);
        show(r, 0);
    }
    printf("17=%s, 99=%s\n", search(r, 17)?"found":"missing", search(r, 99)?"found":"missing");
    freeb(r);
    return 0;
}
