#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define CAP 100
#define HS 211
#define WL 80
typedef struct E {
    char w[WL];
    struct E*n;
}
E;
E*tab[HS];
char words[CAP][WL];
int nwords=0;
unsigned hash(const char*s) {
    unsigned h=2166136261u;
    while(*s) {
        h^=(unsigned char)*s++;
        h*=16777619u;
    }
    return h%HS;
}
int has(const char*w) {
    for(E*e=tab[hash(w)];e;e=e->n)if(!strcmp(e->w, w))return 1;
    return 0;
}
void addhash(const char*w) {
    unsigned h=hash(w);
    E*e=malloc(sizeof*e);
    if(!e)exit(1);
    strcpy(e->w, w);
    e->n=tab[h];
    tab[h]=e;
}
int cmp(const void*a, const void*b) {
    return strcmp((const char*)a, (const char*)b);
}
void add(const char*w) {
    if(has(w)||nwords==CAP)return;
    addhash(w);
    strcpy(words[nwords++], w);
    qsort(words, (size_t)nwords, WL, cmp);
}
int lower(const char*k) {
    int l=0, r=nwords;
    while(l<r) {
        int m=l+(r-l)/2;
        if(strcmp(words[m], k)<0)l=m+1;
        else r=m;
    }
    return l;
}
void prefix(const char*p) {
    size_t m=strlen(p);
    for(int i=lower(p);i<nwords&&!strncmp(words[i], p, m);i++)puts(words[i]);
}
void range(const char*a, const char*b) {
    for(int i=lower(a);i<nwords&&strcmp(words[i], b)<=0;i++)puts(words[i]);
}
void clean(void) {
    for(int i=0;i<HS;i++) {
        E*e=tab[i];
        while(e) {
            E*x=e->n;
            free(e);
            e=x;
        }
    }
}
int main(void) {
    char*a[]= {
        "apple", "apply", "apt", "banana", "band", "bank", "cat", "cater", "dog", "door", "dove", "east"
    }
    ;
    for(int i=0;i<12;i++)add(a[i]);
    printf("bank=%s\n", has("bank")?"found":"missing");
    puts("prefix ba:");
    prefix("ba");
    puts("range cat..dog:");
    range("cat", "dog");
    clean();
    return 0;
}
